;**************************************************************
;*  STM32F407ZGTx 标准链接脚本（适配1MB Flash + 192KB SRAM）   *
;**************************************************************
LR_IROM1 0x08000000 0x00100000  {    ; 加载区域：Flash，起始地址0x08000000，大小1MB
  ER_IROM1 0x08000000 0x00100000  {   ; 执行区域：Flash，与加载区域一致
   *.o (RESET, +First)                ; 强制将RESET段放在最开头（复位向量）
   *(InRoot$$Sections)                ; 链接器必需的根段
   .ANY (+RO)                         ; 所有只读代码/常量
   .ANY (+XO)                         ; 可执行代码段（兼容FreeRTOS/LVGL）
  }
  
  RW_IRAM1 0x20000000 0x00020000  {   ; 读写区域：SRAM1，起始0x20000000，大小128KB
   .ANY (+RW +ZI)                     ; 所有可读写数据/零初始化数据
  }
  
  RW_IRAM2 0x20020000 0x0000C000  {   ; 读写区域：SRAM2，起始0x20020000，大小48KB（F407专属）
   .ANY (+RW +ZI)
  }
}